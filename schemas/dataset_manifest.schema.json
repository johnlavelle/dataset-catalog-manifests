{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dataset Manifest",
  "description": "Manifest describing a dataset's identity, products, and catalog metadata.",
  "type": "object",
  "required": ["dataset", "products"],
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "type": "object",
      "required": ["name", "path"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable dataset name."
        },
        "path": {
          "type": "string",
          "description": "Absolute path to the dataset on the filesystem."
        },
        "model": {
          "type": "string",
          "description": "Model system name (e.g. NEMO, WAM)."
        },
        "domain": {
          "type": "string",
          "description": "Geographic domain (e.g. North Sea - Baltic Sea)."
        },
        "contact": {
          "type": "string",
          "description": "Person responsible for this dataset."
        },
        "description": {
          "type": "string",
          "description": "Brief description of the dataset contents and purpose."
        }
      }
    },
    "stac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "institution": { "type": "string" },
        "purpose": { "type": "string" },
        "model_system": { "type": "string" },
        "cmems_product_code": { "type": "string" },
        "period": { "type": "string" },
        "dois": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Map of product ID to DOI string."
        }
      }
    },
    "products": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["name"],
        "anyOf": [
          { "required": ["dir"] },
          { "required": ["dir_pattern"] }
        ],
        "not": {
          "required": ["dir", "dir_pattern"]
        },
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable product name."
          },
          "dir": {
            "type": "string",
            "description": "Literal subdirectory name under dataset.path containing this product's files."
          },
          "dir_pattern": {
            "type": "string",
            "description": "Shell glob pattern matching multiple subdirectories under dataset.path (e.g. 'n[0-9][0-9][0-4]'). Use instead of dir when a product spans many directories with a naming convention."
          },
          "category": {
            "type": "string",
            "description": "Grouping category. Common values: Physics, Biogeochemistry, Ice, Observations, Assimilation, Waves, Atmospheric. Climate datasets may use activity names (DECK, CMIP, ScenarioMIP, DCPP)."
          },
          "model_component": {
            "type": "string",
            "description": "Model component (e.g. NEMO, ERGOM, SI3)."
          },
          "domain": {
            "type": "string",
            "description": "Geographic domain for this product."
          },
          "type": {
            "type": "string",
            "enum": [
              "final product",
              "original output",
              "raw output",
              "intermediate file",
              "production file",
              "project file",
              "project archive",
              "restart file",
              "diagnostic"
            ],
            "description": "Product type describing the role of this data in the processing chain."
          },
          "notes": {
            "type": "string",
            "description": "Additional notes about this product."
          }
        }
      },
      "description": "Map of product key to product metadata. Each product lives in its own subdirectory (dir) or matches multiple directories (dir_pattern)."
    }
  }
}
