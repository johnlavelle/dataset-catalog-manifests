{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dataset Catalog Config",
  "description": "Manifest describing a dataset's identity, products, and catalog metadata.",
  "type": "object",
  "required": ["dataset", "products"],
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "type": "object",
      "required": ["name", "path"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable dataset name."
        },
        "path": {
          "type": "string",
          "description": "Absolute path to the dataset on the filesystem."
        },
        "model": {
          "type": "string",
          "description": "Model system name (e.g. NEMO, WAM)."
        },
        "domain": {
          "type": "string",
          "description": "Geographic domain (e.g. North Sea - Baltic Sea)."
        }
      }
    },
    "stac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "institution": { "type": "string" },
        "purpose": { "type": "string" },
        "model_system": { "type": "string" },
        "cmems_product_code": { "type": "string" },
        "period": { "type": "string" },
        "dois": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Map of product ID to DOI string."
        }
      }
    },
    "products": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["name", "dir"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable product name."
          },
          "dir": {
            "type": "string",
            "description": "Subdirectory under dataset.path containing this product's files."
          },
          "category": {
            "type": "string",
            "description": "Grouping category (e.g. Physics, Biogeochemistry)."
          },
          "model_component": {
            "type": "string",
            "description": "Model component (e.g. NEMO, ERGOM, SI3)."
          },
          "domain": {
            "type": "string",
            "description": "Geographic domain for this product."
          },
          "type": {
            "type": "string",
            "description": "Product type (e.g. final product, original output, intermediate file)."
          },
          "notes": {
            "type": "string",
            "description": "Additional notes about this product."
          }
        }
      },
      "description": "Map of product key to product metadata. Each product lives in its own subdirectory."
    }
  }
}
