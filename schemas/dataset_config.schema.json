{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dataset Catalog Config",
  "description": "Manifest describing a dataset's identity, file patterns, and catalog metadata.",
  "type": "object",
  "required": ["dataset", "file_patterns"],
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "type": "object",
      "required": ["name", "path"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable dataset name."
        },
        "path": {
          "type": "string",
          "description": "Absolute path to the dataset on the filesystem."
        },
        "model": {
          "type": "string",
          "description": "Model system name (e.g. NEMO, WAM)."
        },
        "domain": {
          "type": "string",
          "description": "Geographic domain (e.g. North Sea - Baltic Sea)."
        }
      }
    },
    "file_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["regex", "label"],
        "additionalProperties": false,
        "properties": {
          "regex": {
            "type": "string",
            "description": "Python regex pattern matching filenames."
          },
          "label": {
            "type": "string",
            "description": "Human-readable label (dates replaced with YYYYMMDD)."
          },
          "category": {
            "type": "string",
            "description": "Grouping category (e.g. Physics, Biogeochemistry)."
          }
        }
      }
    },
    "stac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "institution": { "type": "string" },
        "purpose": { "type": "string" },
        "model_system": { "type": "string" },
        "cmems_product_code": { "type": "string" },
        "period": { "type": "string" },
        "dois": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Map of product ID to DOI string."
        },
        "products": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "model_component": { "type": "string" },
              "domain": { "type": "string" },
              "type": { "type": "string" },
              "notes": { "type": "string" },
              "compression_precision": { "type": "string" }
            }
          },
          "description": "Map of file pattern label to product metadata."
        }
      }
    }
  }
}
